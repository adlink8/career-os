{
  "manifest_version": 3,
  "name": "Career OS 网申自动填表助手",
  "version": "1.10.2",
  "description": "可单独使用的网申填表助手。自由模块内容库 + 手动自适应骨架。不自动提交。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "downloads",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:18765/*",
    "http://localhost:18765/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Career OS 自动填表"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zhiye.com/*",
        "*://*.italent.cn/*",
        "*://*.beisen.com/*",
        "*://*.mokahr.com/*",
        "*://*.moka.com/*",
        "*://*.dayee.com/*",
        "*://*.hotjob.cn/*",
        "*://*.gllue.com/*",
        "*://*.zhaopin.com/*",
        "*://*.51job.com/*",
        "*://*.zhipin.com/*",
        "*://*.lagou.com/*",
        "*://*.liepin.com/*",
        "*://*.nowcoder.com/*",
        "*://*.shixiseng.com/*",
        "*://*.wayzim.com/*",
        "*://*.ninebot.com/*",
        "*://*.moseeker.com/*",
        "*://*.chipown.com.cn/*",
        "*://*.espressif.com/*",
        "*://*.wiicode.cn/*",
        "*://*.skytech.cn/*",
        "*://*.cstor.cn/*",
        "*://*.oneing.com/*"
      ],
      "js": [
        "overlay-store.js",
        "field-map.js",
        "runtime-log.js",
        "shortcuts.js",
        "fill-policy.js",
        "fill-runtime.js",
        "beisen-fill.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
