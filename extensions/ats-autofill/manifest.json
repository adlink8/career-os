{
  "manifest_version": 3,
  "name": "Career OS 网申自动填表助手",
  "version": "1.3.0",
  "description": "捕获当前岗位 JD 与表单格子，按本页 schema 填充。画像不暴露给网页。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "downloads",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:18765/*",
    "http://localhost:18765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Career OS 自动填表"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zhiye.com/*",
        "*://*.italent.cn/*",
        "*://*.beisen.com/*",
        "*://*.mokahr.com/*",
        "*://*.moka.com/*",
        "*://*.dayee.com/*",
        "*://*.hotjob.cn/*",
        "*://*.gllue.com/*",
        "*://*.zhaopin.com/*",
        "*://*.51job.com/*",
        "*://*.zhipin.com/*",
        "*://*.lagou.com/*",
        "*://*.liepin.com/*",
        "*://*.nowcoder.com/*",
        "*://*.shixiseng.com/*"
      ],
      "js": [
        "field-map.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
